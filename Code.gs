function login(p) {
  const loginName = String(p.username||'').trim().toLowerCase(), pass = String(p.password||'');
  const throttleKey='login:'+loginName;throttle_(throttleKey,8,300);
  const admin=adminAccount_();
  if(admin&&admin.username===loginName&&constantTime_(hash_(pass,admin.passwordSalt),admin.passwordHash)){clearThrottle_(throttleKey);return createAdminSession_(admin);}
  if(!CP.props.getProperty('SPREADSHEET_ID'))throw new Error('เข้าสู่ระบบไม่ได้ กรุณาตรวจข้อมูลหรือสถานะบัญชี');
  const users=readRows_('Users');
  const u=users.find(x=>!x.deletedAt && (x.username===loginName || (x.role==='student' && x.studentCode===loginName)));
  if (!u || u.status!=='active' || !constantTime_(hash_(pass,u.passwordSalt),u.passwordHash)) throw new Error('เข้าสู่ระบบไม่ได้ กรุณาตรวจข้อมูลหรือสถานะบัญชี');
