function configureSystem(p){const u=adminOnly_(p,true);const spreadsheetId=String(p.spreadsheetId||'').trim(),driveFolderId=String(p.driveFolderId||'').trim();if(!/^[A-Za-z0-9_-]{20,}$/.test(spreadsheetId)||!/^[A-Za-z0-9_-]{20,}$/.test(driveFolderId))throw new Error('รูปแบบ Spreadsheet ID หรือ Drive folder ID ไม่ถูกต้อง');const oldSheet=CP.props.getProperty('SPREADSHEET_ID'),oldDrive=CP.props.getProperty('DRIVE_FOLDER_ID');try{SpreadsheetApp.openById(spreadsheetId).getSheets();DriveApp.getFolderById(driveFolderId).getName();CP.props.setProperties({SPREADSHEET_ID:spreadsheetId,DRIVE_FOLDER_ID:driveFolderId});setup();audit_(u.id,'configure-system','Config','storage-ids',{});return {ok:true,isConfigured:true};}catch(e){if(oldSheet)CP.props.setProperty('SPREADSHEET_ID',oldSheet);else CP.props.deleteProperty('SPREADSHEET_ID');if(oldDrive)CP.props.setProperty('DRIVE_FOLDER_ID',oldDrive);else CP.props.deleteProperty('DRIVE_FOLDER_ID');throw new Error('ตรวจสอบหรือเตรียม Google Sheets/Drive ไม่สำเร็จ: '+String(e.message||e));}}
function setRegistrationPolicy(p){const u=adminOnly_(p);const allow=p.allowStudentSignup===true,approval=p.requireApproval===true;upsertConfig_('allowStudentSignup',String(allow));upsertConfig_('requireApproval',String(approval));audit_(u.id,'registration-policy','Config','registration',{allowStudentSignup:allow,requireApproval:approval});return {allowStudentSignup:allow,requireApproval:approval};}
function inviteUser(p){const u=adminOnly_(p);const role=String(p.role||''),username=String(p.username||'').trim().toLowerCase(),displayName=clean_(p.displayName,100),studentCode=String(p.studentCode||'').trim(),classId=String(p.classId||'');if(!['teacher','student'].includes(role))throw new Error('เลือกบทบาทครูหรือนักเรียน');if(!/^[a-z0-9._-]{4,30}$/.test(username)||!displayName)throw new Error('กรอกชื่อบัญชีและชื่อที่แสดงให้ถูกต้อง');if(role==='student'&&(!/^[0-9]{5}$/.test(studentCode)||!byId_('Classes',classId)))throw new Error('กรอกรหัสนักเรียน 5 หลักและเลือกห้องเรียน');if(readRows_('Users').some(x=>!x.deletedAt&&(x.username===username||(studentCode&&x.studentCode===studentCode))))throw new Error('ชื่อบัญชีหรือรหัสนักเรียนนี้ถูกใช้แล้ว');const password=token_().slice(0,24),salt=token_(),record={id:uuid_(),role,username,studentCode:role==='student'?studentCode:'',passwordSalt:salt,passwordHash:hash_(password,salt),displayName,email:clean_(p.email,160),classId:role==='student'?classId:'',status:'active',mustChangePassword:true,createdAt:now_(),updatedAt:now_(),deletedAt:''};appendRows_('Users',[record]);audit_(u.id,'invite-user','User',record.id,{role});return {username,password,role};}
function listUsersAdmin(p){adminOnly_(p);return readRows_('Users').filter(x=>!x.deletedAt).map(x=>({id:x.id,role:x.role,username:x.username,studentCode:x.studentCode,displayName:x.displayName,classId:x.classId,status:x.status,mustChangePassword:x.mustChangePassword===true||String(x.mustChangePassword)==='true'}));}
function setUserRole(p){const u=adminOnly_(p),target=byId_('Users',String(p.userId)),role=String(p.role||'');if(!target||target.deletedAt||!['admin','teacher','student'].includes(role))throw new Error('ผู้ใช้หรือบทบาทไม่ถูกต้อง');const bootstrap=adminAccount_();if(bootstrap&&target.id===bootstrap.id&&role!=='admin')throw new Error('บัญชี Admin หลักไม่สามารถลดสิทธิ์ได้');if(target.role==='admin'&&role!=='admin'&&readRows_('Users').filter(x=>x.role==='admin'&&x.status==='active'&&!x.deletedAt).length<=1)throw new Error('ไม่สามารถลดสิทธิ์ Admin คนสุดท้าย');const classId=role==='student'?String(p.classId||target.classId||''):'';if(role==='student'&&!byId_('Classes',classId))throw new Error('เลือกห้องเรียนให้ผู้เรียน');updateById_('Users',target.id,{role,classId,updatedAt:now_()});audit_(u.id,'change-role','User',target.id,{role,classId});return {ok:true};}
function assignClassTeacher(p){const u=adminOnly_(p),c=byId_('Classes',String(p.classId)),teacher=byId_('Users',String(p.teacherId));if(!c||c.deletedAt||!teacher||teacher.deletedAt||!['teacher','admin'].includes(teacher.role))throw new Error('เลือกห้องและบัญชีครูที่ใช้งานได้');const oldOwner=c.ownerId;updateById_('Classes',c.id,{ownerId:teacher.id,updatedAt:now_()});const courseIds=readRows_('Courses').filter(x=>x.classId===c.id&&!x.deletedAt);courseIds.forEach(x=>{if(x.ownerId===oldOwner)updateById_('Courses',x.id,{ownerId:teacher.id,updatedAt:now_()});});const ids=new Set(courseIds.map(x=>x.id));readRows_('Lessons').filter(x=>ids.has(x.courseId)&&x.ownerId===oldOwner&&!x.deletedAt).forEach(x=>updateById_('Lessons',x.id,{ownerId:teacher.id,updatedAt:now_()}));readRows_('Assignments').filter(x=>ids.has(x.courseId)&&x.ownerId===oldOwner&&!x.deletedAt).forEach(x=>updateById_('Assignments',x.id,{ownerId:teacher.id,updatedAt:now_()}));readRows_('Announcements').filter(x=>x.classId===c.id&&x.ownerId===oldOwner&&!x.deletedAt).forEach(x=>updateById_('Announcements',x.id,{ownerId:teacher.id,updatedAt:now_()}));audit_(u.id,'assign-class','Class',c.id,{teacherId:teacher.id});return {ok:true};}

function auth_(p){const t=String(p.token||'');if(!t)throw new Error('กรุณาเข้าสู่ระบบ');const h=hash_(t,'session-v1'),adminSession=adminSessions_().find(x=>x.tokenHash===h&&x.expiresAt>Date.now());if(adminSession){const admin=adminAccount_();if(!admin||admin.id!==adminSession.userId)throw new Error('เซสชันหมดอายุ กรุณาเข้าสู่ระบบใหม่');if(CP.props.getProperty('SPREADSHEET_ID')){const saved=readRows_('Users').find(x=>x.id===admin.id);if(saved&&!saved.deletedAt&&saved.status==='active')return saved;}return {...admin,email:admin.email||'',classId:'',status:'active',mustChangePassword:false};}if(!CP.props.getProperty('SPREADSHEET_ID'))throw new Error('ผู้ดูแลยังไม่ได้ตั้งค่าฐานข้อมูล');const s=readRows_('Sessions').find(x=>x.tokenHash===h&&new Date(x.expiresAt).getTime()>Date.now());if(!s)throw new Error('เซสชันหมดอายุ กรุณาเข้าสู่ระบบใหม่');const u=byId_('Users',s.userId);if(!u||u.deletedAt||u.status!=='active')throw new Error('บัญชีนี้ไม่พร้อมใช้งาน');return u;}
function teacher_(p){const u=auth_(p);if(u.role!=='teacher'&&u.role!=='admin')throw new Error('ต้องใช้สิทธิ์ครู');return u;}
function adminOnly_(p,allowUnconfigured){const u=auth_(p);if(u.role!=='admin')throw new Error('ต้องใช้สิทธิ์ Admin');if(!CP.props.getProperty('SPREADSHEET_ID')&&!allowUnconfigured)throw new Error('ตั้งค่า Google Sheets และ Drive ก่อน');return u;}
function adminAccount_(){try{return JSON.parse(CP.props.getProperty('ADMIN_ACCOUNT')||'null');}catch(_){return null;}}
function adminSessions_(){try{return JSON.parse(CP.props.getProperty('ADMIN_SESSIONS')||'[]').filter(x=>x.expiresAt>Date.now());}catch(_){return [];}}
function createAdminSession_(admin){const raw=token_(),sessions=adminSessions_();sessions.push({userId:admin.id,tokenHash:hash_(raw,'session-v1'),expiresAt:Date.now()+CP.sessionDays*86400000});CP.props.setProperty('ADMIN_SESSIONS',JSON.stringify(sessions.slice(-100)));return {token:raw,user:safeUser_({...admin,email:admin.email||'',classId:'',status:'active',mustChangePassword:false}),expiresAt:new Date(sessions[sessions.length-1].expiresAt).toISOString()};}
function syncBootstrapAdmin_(){const admin=adminAccount_();if(!admin||!CP.props.getProperty('SPREADSHEET_ID'))return;const old=byId_('Users',admin.id);const row={id:admin.id,role:'admin',username:admin.username,studentCode:'',passwordSalt:admin.passwordSalt,passwordHash:admin.passwordHash,displayName:admin.displayName,email:admin.email||'',classId:'',status:'active',mustChangePassword:false,createdAt:admin.createdAt,updatedAt:now_(),deletedAt:''};if(old)updateById_('Users',row.id,row);else appendRows_('Users',[row]);}
function upsertConfig_(key,value){const sh=SpreadsheetApp.openById(CP.props.getProperty('SPREADSHEET_ID')).getSheetByName('Config'),lock=LockService.getScriptLock();lock.waitLock(10000);try{const rows=sh.getDataRange().getValues(),heads=rows[0],ki=heads.indexOf('key'),vi=heads.indexOf('value'),ti=heads.indexOf('updatedAt');for(let i=1;i<rows.length;i++)if(String(rows[i][ki])===key){rows[i][vi]=value;if(ti>=0)rows[i][ti]=now_();sh.getRange(i+1,1,1,heads.length).setValues([rows[i]]);return;}const row={key,value,updatedAt:now_()};sh.getRange(sh.getLastRow()+1,1,1,heads.length).setValues([heads.map(h=>row[h]===undefined?'':row[h])]);}finally{lock.releaseLock();}}
function visible_(sheet,u){const rows=readRows_(sheet).filter(r=>!r.deletedAt);if(u.role==='admin')return rows;if(u.role==='student'){if(sheet==='Courses')return rows.filter(r=>r.classId&&r.classId===u.classId);if(sheet==='Assignments'){const ids=visible_('Courses',u).map(c=>c.id);return rows.filter(r=>ids.includes(r.courseId));}return rows.filter(r=>r.ownerId===u.id);}const classes=readRows_('Classes').filter(c=>c.ownerId===u.id&&!c.deletedAt).map(c=>c.id);if(sheet==='Courses')return rows.filter(r=>r.ownerId===u.id||classes.includes(r.classId));if(sheet==='Assignments'){const ids=visible_('Courses',u).map(c=>c.id);return rows.filter(r=>ids.includes(r.courseId));}return rows.filter(r=>r.ownerId===u.id);}
function safeUser_(u){return {id:u.id,role:u.role,username:u.username,displayName:u.displayName,email:u.email,classId:u.classId,status:u.status,mustChangePassword:u.mustChangePassword===true||String(u.mustChangePassword)==='true'};}
function byId_(sheet,id){return readRows_(sheet).find(r=>r.id===id)||null;}
function readRows_(name){const id=CP.props.getProperty('SPREADSHEET_ID');if(!id)throw new Error('ผู้ดูแลยังไม่ได้ตั้งค่า SPREADSHEET_ID');const sh=SpreadsheetApp.openById(id).getSheetByName(name);if(!sh||sh.getLastRow()<2)return [];const v=sh.getDataRange().getValues(),heads=v.shift();return v.filter(row=>row.some(x=>x!==''&&x!==null)).map(row=>Object.fromEntries(heads.map((h,i)=>[h,row[i] instanceof Date?row[i].toISOString():row[i]])));}
function appendRows_(name,rows){if(!rows.length)return;const sh=SpreadsheetApp.openById(CP.props.getProperty('SPREADSHEET_ID')).getSheetByName(name),heads=sh.getRange(1,1,1,sh.getLastColumn()).getValues()[0];const values=rows.map(r=>heads.map(h=>r[h]===undefined?'':r[h]));const lock=LockService.getScriptLock();lock.waitLock(10000);try{sh.getRange(sh.getLastRow()+1,1,values.length,heads.length).setValues(values);}finally{lock.releaseLock();}}
function updateById_(name,id,obj){const sh=SpreadsheetApp.openById(CP.props.getProperty('SPREADSHEET_ID')).getSheetByName(name),lock=LockService.getScriptLock();lock.waitLock(10000);try{const v=sh.getDataRange().getValues(),heads=v[0],idx=heads.indexOf('id');for(let i=1;i<v.length;i++)if(String(v[i][idx])===String(id)){heads.forEach((h,j)=>{if(Object.prototype.hasOwnProperty.call(obj,h))v[i][j]=obj[h];});sh.getRange(i+1,1,1,heads.length).setValues([v[i]]);return;}throw new Error('ไม่พบรายการที่ต้องการแก้ไข');}finally{lock.releaseLock();}}
function updateWhere_(name,pred,changes){const rows=readRows_(name);rows.filter(pred).forEach(r=>updateById_(name,r.id,changes));}
function readConfig_(key){const r=readRows_('Config').find(x=>x.key===key);return r?String(r.value):'';}
function audit_(actor,action,type,id,details){appendRows_('AuditLog',[{id:uuid_(),actorId:actor,action,entityType:type,entityId:id,details:JSON.stringify(details||{}),createdAt:now_()}]);}
function hash_(s,salt){let out=String(salt)+':'+String(s);for(let i=0;i<12000;i++)out=Utilities.base64Encode(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,out,Utilities.Charset.UTF_8));return out;}
function constantTime_(a,b){if(!b||a.length!==b.length)return false;let x=0;for(let i=0;i<a.length;i++)x|=a.charCodeAt(i)^b.charCodeAt(i);return x===0;}
function token_(){return Utilities.getUuid()+Utilities.getUuid()+Utilities.getUuid();}
function uuid_(){return Utilities.getUuid();}
function throttle_(bucket,max,seconds){const cache=CacheService.getScriptCache(),digest=Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(bucket))).slice(0,32),key='cp_rate_'+digest,count=Number(cache.get(key)||0);if(count>=max)throw new Error('ลองหลายครั้งเกินไป กรุณารอสักครู่แล้วลองใหม่');cache.put(key,String(count+1),seconds);}
function clearThrottle_(bucket){const digest=Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(bucket))).slice(0,32);CacheService.getScriptCache().remove('cp_rate_'+digest);}
function now_(){return new Date().toISOString();}
function clean_(v,max){return String(v||'').replace(/[\u0000-\u0008\u000B\u000C\u000E-\u001F]/g,'').trim().slice(0,max);}
function safeUrl_(v){const s=String(v||'').trim();if(!s)return '';if(!/^https:\/\//i.test(s))throw new Error('ลิงก์ต้องขึ้นต้นด้วย https://');return s.slice(0,1000);}
