  sheets: {
    Config: ['key','value','updatedAt'],
    Users: ['id','role','username','studentCode','passwordSalt','passwordHash','displayName','email','classId','status','mustChangePassword','createdAt','updatedAt','deletedAt'],
    Sessions: ['id','userId','tokenHash','expiresAt','createdAt'],
    Classes: ['id','name','grade','joinCode','ownerId','createdAt','updatedAt','deletedAt'],
    Courses: ['id','classId','name','description','ownerId','createdAt','updatedAt','deletedAt'],
    Lessons: ['id','courseId','title','content','mediaUrl','ownerId','createdAt','updatedAt','deletedAt'],
    Announcements: ['id','classId','title','body','ownerId','createdAt','updatedAt','deletedAt'],
    Assignments: ['id','courseId','title','description','dueAt','maxPoints','ownerId','createdAt','updatedAt','deletedAt'],
    Submissions: ['id','assignmentId','studentId','text','fileUrl','submittedAt','updatedAt','deletedAt'],
    Grades: ['id','submissionId','studentId','points','feedback','gradedBy','gradedAt'],
    AuditLog: ['id','actorId','action','entityType','entityId','details','createdAt']
  },
  sessionDays: 7,
  maxUploadBytes: 8 * 1024 * 1024,
  props: PropertiesService.getScriptProperties()
});

function doGet(e) {
  if (String((e && e.parameter && e.parameter.mode) || '') === 'bridge') {
    const bridge = HtmlService.createTemplateFromFile('Bridge');
    return bridge.evaluate().setTitle('Classroom Plus Bridge').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
  }
  return HtmlService.createTemplateFromFile('Index').evaluate().setTitle('Classroom Plus').addMetaTag('viewport','width=device-width, initial-scale=1');
}
function include(name) { return HtmlService.createHtmlOutputFromFile(name).getContent(); }

/** Idempotent: creates missing tabs/headers only; never clears existing rows. */
function setup() {
  const id = CP.props.getProperty('SPREADSHEET_ID');
  if (!id) throw new Error('ตั้งค่า SPREADSHEET_ID ใน Script Properties ก่อนเรียก setup()');
  const ss = SpreadsheetApp.openById(id);
  Object.keys(CP.sheets).forEach(name => {
    let sh = ss.getSheetByName(name);
    if (!sh) sh = ss.insertSheet(name);
    const headers = CP.sheets[name];
    if (sh.getLastRow() === 0) sh.getRange(1,1,1,headers.length).setValues([headers]);
    else {
      const existing = sh.getRange(1,1,1,Math.max(sh.getLastColumn(), headers.length)).getValues()[0];
      headers.forEach(h => { if (!existing.includes(h)) { const col = Math.max(sh.getLastColumn(),1)+1; sh.getRange(1,col).setValue(h); } });
    }
    sh.setFrozenRows(1);
  });
  const config = readRows_('Config');
  const defaults=[['requireApproval','false'],['allowStudentSignup','false']];
  defaults.forEach(([key,value])=>{if(!config.some(r=>r.key===key))appendRows_('Config',[{key,value,updatedAt:now_()}]);});
  syncBootstrapAdmin_();
  return {ok:true, message:'สร้าง/ตรวจโครงสร้างชีตแล้ว โดยไม่ลบข้อมูลเดิม'};
}

/** Run from the Apps Script editor. Copy the returned code into the Pages bootstrap form. */
function prepareAdminBootstrap_() {
  if(CP.props.getProperty('ADMIN_ACCOUNT'))throw new Error('ตั้งค่า Admin แล้ว');
  const code=token_();CP.props.setProperties({ADMIN_BOOTSTRAP_HASH:hash_(code,'admin-bootstrap-v1'),ADMIN_BOOTSTRAP_EXPIRES:String(Date.now()+30*60*1000)});
  return {code,expiresInMinutes:30,message:'คัดลอกรหัสนี้ครั้งเดียวไปกรอกในหน้า bootstrap ของ GitHub Pages'};
}

function api(action, payload) {
  payload = payload || {};
  const allowed = { bootstrapStatus, completeBootstrap, register, login, logout, me, dashboard, listCourses, saveCourse, listLessons, saveLesson, listAnnouncements, saveAnnouncement, listAssignments, saveAssignment, submitAssignment, listSubmissions, gradeSubmission, listClasses, saveClass, listStudents, setStudentStatus, changePassword, updateProfile, configureSystem, setRegistrationPolicy, inviteUser, listUsersAdmin, setUserRole, assignClassTeacher };
  if (!Object.prototype.hasOwnProperty.call(allowed, action)) throw new Error('ไม่รองรับคำขอนี้');
  return allowed[action](payload);
}
