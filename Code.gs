  appendRows_('Sessions',[{id,userId:u.id,tokenHash:hash_(raw,'session-v1'),expiresAt:expires,createdAt:now_()}]);
  clearThrottle_(throttleKey);return {token:raw,user:safeUser_(u),expiresAt:expires};
}
