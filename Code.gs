function register(p) {
  if(!CP.props.getProperty('SPREADSHEET_ID'))throw new Error('ระบบยังไม่ได้ตั้งค่าฐานข้อมูล');
  if(readConfig_('allowStudentSignup')!=='true')throw new Error('ปิดรับสมัครอยู่ กรุณาขอคำเชิญจากผู้ดูแล');
  const name = clean_(p.displayName,100), username = String(p.username||'').trim().toLowerCase(), pass = String(p.password||'');
  if (!name || !/^[0-9]{5}$/.test(String(p.studentCode||''))) throw new Error('กรุณากรอกชื่อและรหัสนักเรียน 5 หลัก');
  if (!/^[a-z0-9._-]{4,30}$/.test(username) || pass.length < 10) throw new Error('ชื่อบัญชี 4–30 ตัวอักษร และรหัสผ่านอย่างน้อย 10 ตัว');
  const joinCode=String(p.joinCode||'').trim().toUpperCase();
  const targetClass=joinCode?readRows_('Classes').find(c=>c.joinCode===joinCode&&!c.deletedAt):null;
  if(!joinCode||!targetClass)throw new Error('กรุณากรอกรหัสเข้าห้องเรียนที่ได้รับจากครู');
  const users = readRows_('Users');
  if (users.some(u => !u.deletedAt && (u.username===username || u.studentCode===String(p.studentCode)))) throw new Error('ข้อมูลบัญชีนี้ไม่สามารถใช้สมัครได้');
  const salt = token_();
  const pending = readConfig_('requireApproval') === 'true';
  const user = {id:uuid_(),role:'student',username,studentCode:String(p.studentCode),passwordSalt:salt,passwordHash:hash_(pass,salt),displayName:name,email:clean_(p.email,160),classId:targetClass.id,status:pending?'pending':'active',mustChangePassword:false,createdAt:now_(),updatedAt:now_(),deletedAt:''};
  appendRows_('Users',[user]); audit_(user.id,'register','User',user.id,{});
  return {ok:true,pending};
